# ==============================================================================
# PROJETO: Cozinha Guiada — Configuração de Ambiente (.env)
# ==============================================================================

# Conexão com o Banco de Dados (Supabase / PostgreSQL ou MySQL local)
# Opção 1: URL de conexão do Connection Pooler do Supabase (Recomendado para Vercel):
# DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# Opção 2: Variáveis individuais para o Connection Pooler do Supabase:
DB_HOST=aws-0-sa-east-1.pooler.supabase.com
DB_PORT=6543
DB_NAME=postgres
DB_USER=postgres.[PROJECT-REF]
DB_PASS=
DB_SSLMODE=require

# Modo de Depuração (ative APP_DEBUG=true na Vercel para inspecionar erros):
APP_DEBUG=false
APP_ENV=production

# Upload de imagens (5 MiB)
UPLOAD_MAX_SIZE=5242880
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp
