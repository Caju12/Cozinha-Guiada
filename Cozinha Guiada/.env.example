# ==============================================================================
# PROJETO: Cozinha Guiada — Configuração de Ambiente (.env)
# ==============================================================================
# Copie este arquivo para .env e preencha as variáveis de acordo com o seu ambiente.
# NUNCA envie o arquivo .env real para o GitHub.

# ------------------------------------------------------------------------------
# OPÇÃO A: Conexão Local com MySQL / MariaDB (Ambiente XAMPP local)
# ------------------------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=cozinha_guiada
DB_USER=root
DB_PASS=

# ------------------------------------------------------------------------------
# OPÇÃO B: Conexão Nuvem com Supabase / PostgreSQL (Vercel / Produção)
# Use a URL do Connection Pooler (porta 6543) para garantir compatibilidade IPv4:
# ------------------------------------------------------------------------------
# DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
DB_SSLMODE=require

# ------------------------------------------------------------------------------
# Configurações Gerais da Aplicação
# ------------------------------------------------------------------------------
APP_ENV=development
APP_DEBUG=true

# ------------------------------------------------------------------------------
# Políticas de Upload de Imagens (5 MiB e formatos suportados)
# ------------------------------------------------------------------------------
UPLOAD_MAX_SIZE=5242880
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp
